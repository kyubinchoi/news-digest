# Anthropic API 키 (https://console.anthropic.com 에서 발급)
ANTHROPIC_API_KEY=

# 매일 요약을 생성할 시각 (KST 기준, 24시간제, 예: 07:00)
DIGEST_HOUR=7
DIGEST_MINUTE=0

# 로컬 실행 시에는 비워두면 SQLite(news.db 파일)를 사용합니다.
# Render 등에 배포할 때는 Postgres 연결 문자열을 넣어주세요. (예: Supabase, Neon, Render Postgres)
# 예: postgresql://user:password@host:5432/dbname
DATABASE_URL=
